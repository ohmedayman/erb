generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Store {
  id              String    @id @default(cuid())
  name            String
  description     String?
  logo            String?
  website         String?
  category        String    @default("Electronics")
  taxId           String?
  currency        String    @default("USD")
  timezone        String    @default("America/New_York")
  address         String?
  city            String?
  state           String?
  zipCode         String?
  country         String?
  ownerName       String
  ownerEmail      String
  ownerPhone      String?
  emailNotifs     Boolean   @default(true)
  orderAlerts     Boolean   @default(true)
  lowStockAlerts  Boolean   @default(true)
  weeklyReports   Boolean   @default(false)
  createdAt       DateTime  @default(now())

  users           User[]
  products        Product[]
  orders          Order[]
  teamMembers     TeamMember[]
  purchaseOrders  PurchaseOrder[]
  notifications   Notification[]
  warehouses      Warehouse[]
  suppliers       Supplier[]
  stockMovements  StockMovement[]
  activityLogs    ActivityLog[]
  returns         Return[]
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  password      String
  fullName      String
  role          String   @default("admin")
  createdAt     DateTime @default(now())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  sku         String   @unique
  category    String
  price       Float
  stock       Int      @default(0)
  minStock    Int      @default(10)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique
  customerName  String
  customerPhone String?
  customerEmail String?
  items         Int
  total         Float
  status        String   @default("Pending")
  payment       String   @default("Pending")
  notes         String?
  date          DateTime @default(now())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  shipments     Shipment[]
}

model Shipment {
  id              String  @id @default(cuid())
  shipmentNumber  String  @unique
  carrier         String
  trackingNumber  String?
  status          String  @default("Processing")
  origin          String
  destination     String
  eta             String
  notes           String?
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String   @default("Staff")
  status    String   @default("Active")
  joinedAt  DateTime @default(now())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  poNumber        String   @unique
  supplierName    String
  items           Int
  total           Float
  status          String   @default("Pending")
  expectedDate    String?
  notes           String?
  createdAt       DateTime @default(now())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  capacity    Int      @default(1000)
  used        Int      @default(0)
  manager     String?
  phone       String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  contactName String?
  email       String?
  phone       String?
  address     String?
  category    String?
  rating      Int      @default(5)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
}

model StockMovement {
  id            String   @id @default(cuid())
  productName   String
  sku           String
  type          String
  quantity      Int
  fromLocation  String?
  toLocation    String?
  reference     String?
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  user      String
  createdAt DateTime @default(now())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
}

model Return {
  id            String   @id @default(cuid())
  returnNumber  String   @unique
  orderNumber   String
  customerName  String
  reason        String
  quantity      Int
  status        String   @default("Pending")
  refundAmount  Float
  notes         String?
  createdAt     DateTime @default(now())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
}
